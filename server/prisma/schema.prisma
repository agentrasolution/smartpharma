generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Multi-tenant core
// ============================================================

model Pharmacy {
  id           String        @id @default(uuid())
  name         String        @unique
  slug         String        @unique
  contact      String        @default("")
  phone        String        @default("")
  email        String        @default("")
  address      String        @default("")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  subscription Subscription?
  users        User[]
  branches     Branch[]
  roles        Role[]
  products     Product[]
  categories   Category[]
  distributors Distributor[]
  companies    Company[]
  barcodes     Barcode[]
  recoveryKeys RecoveryKey[]
  customers    Customer[]
  sales        Sale[]
  stockPurchases StockPurchase[]
  returns      ReturnEntry[]
  arrears      Arrear[]
  expenses     Expense[]
  purchaseOrders PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]
  distributorPayments DistributorPayment[]
  prescriptions Prescription[]
  controlledRegisters ControlledDrugRegister[]
  chronicMedications ChronicMedication[]
  stockTransfers     StockTransfer[]
  branchPriceOverrides BranchPriceOverride[]

  @@map("pharmacies")
}

model Subscription {
  id          String    @id @default(uuid())
  pharmacyId  String    @unique @map("pharmacy_id")
  plan        String    @default("monthly")
  price       Float     @default(0)
  status      String    @default("trial")
  startedAt   DateTime  @default(now()) @map("started_at")
  renewsAt    DateTime  @map("renews_at")
  cancelledAt DateTime? @map("cancelled_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  pharmacy    Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ============================================================
// AI Inventory Intelligence Layer (additive)
// Does NOT modify any existing POS models.
// ============================================================

model InventoryConfig {
  id                      String   @id @default(uuid())
  defaultSafetyStockDays  Int      @default(2) @map("default_safety_stock_days")
  defaultTargetStockDays  Int      @default(14) @map("default_target_stock_days")
  defaultAnalysisDays     Int      @default(30) @map("default_analysis_days")
  lowStockThreshold       Int      @default(10) @map("low_stock_threshold")
  overstockCoverageDays   Int      @default(90) @map("overstock_coverage_days")
  trendThresholdPercent   Float    @default(15) @map("trend_threshold_percent")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("inventory_config")
}

model DistributorInventoryConfig {
  id                  String      @id @default(uuid())
  distributorId       String      @unique @map("distributor_id")
  defaultLeadTimeDays Int         @default(3) @map("default_lead_time_days")
  minimumOrderValue   Float       @default(0) @map("minimum_order_value")
  active              Int         @default(1)
  distributor         Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@map("distributor_inventory_config")
}

model ProductDistributorConfig {
  id               String      @id @default(uuid())
  productId        String      @map("product_id")
  distributorId    String      @map("distributor_id")
  leadTimeDays     Int?        @map("lead_time_days")
  minimumOrderQty  Int?        @map("minimum_order_qty")
  purchasePrice    Float?      @map("purchase_price")
  preferred        Int         @default(0)
  product          Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  distributor      Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@unique([productId, distributorId])
  @@map("product_distributor_config")
}

model PurchaseOrder {
  id               String             @id @default(uuid())
  orderNumber      String             @unique @map("order_number")
  pharmacyId       String             @map("pharmacy_id")
  branchId         String             @map("branch_id")
  distributorId    String             @map("distributor_id")
  companyId        String?            @map("company_id")
  status           String             @default("DRAFT")
  subtotal         Float              @default(0)
  total            Float              @default(0)
  notes            String             @default("")
  createdBy        String?            @map("created_by")
  approvedBy       String?            @map("approved_by")
  approvedAt       DateTime?          @map("approved_at")
  rejectedBy       String?            @map("rejected_by")
  rejectedAt       DateTime?          @map("rejected_at")
  rejectionReason  String?            @map("rejection_reason")
  idempotencyKey   String?            @unique @map("idempotency_key")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  pharmacy         Pharmacy           @relation(fields: [pharmacyId], references: [id])
  branch           Branch             @relation(fields: [branchId], references: [id])
  distributor      Distributor        @relation(fields: [distributorId], references: [id])
  company          Company?           @relation(fields: [companyId], references: [id])
  items            PurchaseOrderItem[]

  @@index([pharmacyId])
  @@index([branchId])
  @@index([distributorId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String        @map("purchase_order_id")
  productId       String        @map("product_id")
  quantity        Int
  unitPrice       Float         @default(0) @map("unit_price")
  total           Float         @default(0)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("purchase_order_items")
}

model AIInventoryRecommendation {
  id                    String    @id @default(uuid())
  productId             String    @map("product_id")
  distributorId         String?   @map("distributor_id")
  riskLevel             String    @map("risk_level")
  currentStock          Int       @default(0) @map("current_stock")
  averageDailySales     Float     @default(0) @map("average_daily_sales")
  stockCoverageDays     Float?    @map("stock_coverage_days")
  estimatedStockoutDays Float?    @map("estimated_stockout_days")
  leadTimeDays          Int?      @map("lead_time_days")
  reorderPoint          Float?    @map("reorder_point")
  recommendedQuantity   Int       @default(0) @map("recommended_quantity")
  reason                String    @default("")
  status                String    @default("NEW")
  createdAt             DateTime  @default(now()) @map("created_at")
  expiresAt             DateTime? @map("expires_at")
  product               Product   @relation(fields: [productId], references: [id])

  @@index([status])
  @@index([riskLevel])
  @@index([createdAt])
  @@map("ai_inventory_recommendations")
}

model AIAuditLog {
  id                String    @id @default(uuid())
  userId            String?   @map("user_id")
  agentName         String    @map("agent_name")
  conversationId    String?   @map("conversation_id")
  toolName          String?   @map("tool_name")
  action            String
  inputJson         Json?     @map("input_json")
  outputJson        Json?     @map("output_json")
  status            String
  approvalRequired  Boolean   @default(false) @map("approval_required")
  approvalStatus    String?   @map("approval_status")
  approvedBy        String?   @map("approved_by")
  errorMessage      String?   @map("error_message")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([userId])
  @@map("ai_audit_logs")
}

model AIConversation {
  id        String       @id @default(uuid())
  userId    String?      @map("user_id")
  title     String?
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  messages  AIMessage[]

  @@map("ai_conversations")
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String         @map("conversation_id")
  role           String
  content        String
  toolName       String?        @map("tool_name")
  toolCallId     String?        @map("tool_call_id")
  thoughtSignature String?      @map("thought_signature")
  toolCalls      Json?          @map("tool_calls")
  createdAt      DateTime       @default(now()) @map("created_at")
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

model User {
  id                  String      @id @default(uuid())
  pharmacyId          String      @map("pharmacy_id")
  username            String      @unique
  passwordHash        String      @map("password_hash")
  name                String      @default("") @map("name")
  phone               String      @default("")
  email               String      @default("")
  role                String      @default("admin")
  roleId              String?     @map("role_id")
  branchId            String?     @map("branch_id")
  jobRole             String      @default("") @map("job_role")
  isActive            Boolean     @default(true) @map("is_active")
  mustChangePassword  Boolean     @default(true) @map("must_change_password")
  passwordChangedAt   DateTime?   @map("password_changed_at")
  lastLoginAt         DateTime?   @map("last_login_at")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  pharmacy            Pharmacy    @relation(fields: [pharmacyId], references: [id])
  roleRef             Role?       @relation(fields: [roleId], references: [id])
  branch              Branch?     @relation(fields: [branchId], references: [id])
  authTokens          AuthToken[]

  @@index([pharmacyId])
  @@index([roleId])
  @@index([branchId])
  @@index([isActive])
  @@map("users")
}

model Branch {
  id         String    @id @default(uuid())
  pharmacyId String    @map("pharmacy_id")
  name       String
  address    String    @default("") @map("address")
  phone      String    @default("") @map("phone")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  pharmacy   Pharmacy  @relation(fields: [pharmacyId], references: [id])
  users      User[]
  products   Product[]
  customers  Customer[]
  sales      Sale[]
  stockPurchases StockPurchase[]
  returns    ReturnEntry[]
  arrears    Arrear[]
  expenses   Expense[]
  purchaseOrders PurchaseOrder[]
  batches        Batch[]
  stockMovements StockMovement[]
  purchaseInvoices PurchaseInvoice[]
  distributorPayments DistributorPayment[]
  prescriptions Prescription[]
  controlledRegisters ControlledDrugRegister[]
  chronicMedications ChronicMedication[]
  allowPriceOverride  Boolean               @default(true) @map("allow_price_override")
  transfersSent       StockTransfer[]       @relation("TransfersSent")
  transfersReceived   StockTransfer[]       @relation("TransfersReceived")
  branchPriceOverrides BranchPriceOverride[]

  @@index([pharmacyId])
  @@map("branches")
}

model AuthToken {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  accessToken      String   @unique @map("access_token")
  refreshToken     String   @unique @map("refresh_token")
  csrfToken        String   @map("csrf_token")
  accessExpiresAt  DateTime @map("access_expires_at")
  refreshExpiresAt DateTime @map("refresh_expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_tokens")
}

model RecoveryKey {
  id          String    @id @default(uuid())
  pharmacyId  String?   @map("pharmacy_id")
  keyHash     String    @map("key_hash")
  createdAt   DateTime  @default(now()) @map("created_at")
  usedAt      DateTime? @map("used_at")
  pharmacy    Pharmacy? @relation(fields: [pharmacyId], references: [id])

  @@map("recovery_keys")
}

model Role {
  id          String            @id @default(uuid())
  pharmacyId  String            @map("pharmacy_id")
  name        String
  description String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  pharmacy    Pharmacy          @relation(fields: [pharmacyId], references: [id])
  users       User[]
  permissions RolePermission[]

  @@unique([pharmacyId, name])
  @@index([pharmacyId])
  @@map("roles")
}

model Permission {
  id          String            @id @default(uuid())
  name        String            @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Product {
  id             String           @id @default(uuid())
  pharmacyId     String           @map("pharmacy_id")
  branchId       String           @map("branch_id")
  barcode        String
  name           String
  company        String           @default("")
  category       String           @default("")
  location       String           @default("")
  distributorId  String?          @map("distributor_id")
  salePrice      Float            @default(0) @map("sale_price")
  purchasePrice  Float            @default(0) @map("purchase_price")
  markupPercent  Float            @default(20) @map("markup_percent")
  stockQty       Int              @default(0) @map("stock_qty")
  expiry         String?
  packSize       Int              @default(1) @map("pack_size")
  // ---- Drug Master Data ----
  nameEn                String   @default("") @map("name_en")
  nameAr                String   @default("") @map("name_ar")
  genericName           String   @default("") @map("generic_name")
  dosageForm            String   @default("TABLET") @map("dosage_form")
  strength              String   @default("") @map("strength")
  sfdaCode              String?  @map("sfda_code")
  isRx                  Boolean  @default(false) @map("is_rx")
  isControlled          Boolean  @default(false) @map("is_controlled")
  isPriceRegulated      Boolean  @default(false) @map("is_price_regulated")
  publicPrice           Decimal  @default(0) @db.Decimal(12,4) @map("public_price")
  baseUnit              String   @default("TABLET") @map("base_unit")
  packageUnit           String   @default("BOX") @map("package_unit")
  unitsPerPack          Int      @default(1) @map("units_per_pack")
  active         Int              @default(1)
  createdAt      DateTime         @default(now()) @map("created_at")
  pharmacy       Pharmacy         @relation(fields: [pharmacyId], references: [id])
  branch         Branch           @relation(fields: [branchId], references: [id])
  distributor    Distributor?     @relation(fields: [distributorId], references: [id])
  saleItems      SaleItem[]
  stockPurchases StockPurchase[]
  returnItems    ReturnItem[]
  prices         ProductPrice[]
  barcodeLink    Barcode?
  distributorConfigs ProductDistributorConfig[]
  purchaseOrderItems PurchaseOrderItem[]
  recommendations    AIInventoryRecommendation[]
  batches            Batch[]
  movements          StockMovement[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  prescriptionItems    PrescriptionItem[]
  dispensedRecords     DispenseRecord[] @relation("DispensedProduct")
  controlledRegisters  ControlledDrugRegister[]
  chronicMedications   ChronicMedication[]
  transferItems        StockTransferItem[]
  branchPriceOverrides BranchPriceOverride[]

  @@unique([branchId, barcode])
  @@index([pharmacyId])
  @@index([branchId])
  @@map("products")
}

model Barcode {
  id         String    @id @default(uuid())
  pharmacyId String    @map("pharmacy_id")
  code       String    @unique
  productId  String?   @unique @map("product_id")
  product    Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  pharmacy   Pharmacy  @relation(fields: [pharmacyId], references: [id])
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([pharmacyId])
  @@map("barcodes")
}

model ProductPrice {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  label         String   @default("Standard")
  purchasePrice Float    @default(0) @map("purchase_price")
  salePrice     Float    @default(0) @map("sale_price")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_prices")
}

model Distributor {
  id         String    @id @default(uuid())
  pharmacyId String    @map("pharmacy_id")
  name       String
  contact    String    @default("")
  phone      String    @default("")
  address    String    @default("")
  companyId  String?   @map("company_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  pharmacy   Pharmacy  @relation(fields: [pharmacyId], references: [id])
  company    Company?  @relation(fields: [companyId], references: [id])
  products   Product[]
  stockPurchases StockPurchase[]
  inventoryConfig DistributorInventoryConfig?
  productConfigs ProductDistributorConfig[]
  purchaseOrders PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]
  distributorPayments DistributorPayment[]

  @@unique([pharmacyId, name])
  @@index([pharmacyId])
  @@map("distributors")
}

model Company {
  id            String        @id @default(uuid())
  pharmacyId    String        @map("pharmacy_id")
  name          String
  contact       String        @default("")
  phone         String        @default("")
  secondNumber  String        @default("") @map("second_number")
  address       String        @default("")
  createdAt     DateTime      @default(now()) @map("created_at")
  pharmacy      Pharmacy      @relation(fields: [pharmacyId], references: [id])
  distributors  Distributor[]
  stockPurchases StockPurchase[]
  purchaseOrders PurchaseOrder[]

  @@unique([pharmacyId, name])
  @@index([pharmacyId])
  @@map("companies")
}

model Customer {
  id                    String              @id @default(uuid())
  pharmacyId            String              @map("pharmacy_id")
  branchId              String              @map("branch_id")
  name                  String
  phone                 String              @default("")
  address               String              @default("")
  fatherName            String              @default("") @map("father_name")
  fatherPhone           String              @default("") @map("father_phone")
  nationalId            String              @default("") @map("national_id")
  dateOfBirth           DateTime?           @map("date_of_birth")
  gender                String              @default("") @map("gender") // MALE, FEMALE, OTHER
  bloodGroup            String              @default("") @map("blood_group")
  allergies             String[]            @default([]) @map("allergies")
  chronicConditions     String[]            @default([]) @map("chronic_conditions")
  emergencyContactName  String              @default("") @map("emergency_contact_name")
  emergencyContactPhone String              @default("") @map("emergency_contact_phone")
  creditLimit           Float               @default(0) @map("credit_limit")
  allowCredit           Boolean             @default(true) @map("allow_credit")
  notes                 String              @default("")
  consentGiven          Boolean             @default(false) @map("consent_given")
  consentDate           DateTime?           @map("consent_date")
  consentNotes          String              @default("") @map("consent_notes")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @default(now()) @updatedAt @map("updated_at")
  pharmacy              Pharmacy            @relation(fields: [pharmacyId], references: [id])
  branch                Branch              @relation(fields: [branchId], references: [id])
  sales                 Sale[]
  arrears               Arrear[]
  chronicMedications    ChronicMedication[]

  @@index([pharmacyId])
  @@index([branchId])
  @@map("customers")
}

model ChronicMedication {
  id                String    @id @default(uuid())
  pharmacyId        String    @map("pharmacy_id")
  branchId          String    @map("branch_id")
  customerId        String    @map("customer_id")
  productId         String?   @map("product_id")
  medicationName    String    @map("medication_name")
  dosage            String    @default("")
  frequency         String    @default("")
  daysSupply        Int       @default(30) @map("days_supply")
  lastDispensedDate DateTime  @default(now()) @map("last_dispensed_date")
  nextRefillDate    DateTime  @map("next_refill_date")
  reminderActive    Boolean   @default(true) @map("reminder_active")
  status            String    @default("ACTIVE") // ACTIVE, PAUSED, DISCONTINUED
  notes             String    @default("")
  lastContactedAt   DateTime? @map("last_contacted_at")
  contactNotes      String    @default("") @map("contact_notes")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  pharmacy          Pharmacy  @relation(fields: [pharmacyId], references: [id])
  branch            Branch    @relation(fields: [branchId], references: [id])
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product           Product?  @relation(fields: [productId], references: [id])

  @@index([pharmacyId])
  @@index([branchId])
  @@index([customerId])
  @@index([nextRefillDate])
  @@map("chronic_medications")
}

model Sale {
  id                 String        @id
  pharmacyId         String        @map("pharmacy_id")
  branchId           String        @map("branch_id")
  customerId         String?       @map("customer_id")
  subtotal           Float         @default(0)
  discount           Float         @default(0)
  total              Float         @default(0)
  amountPaid         Float         @default(0) @map("amount_paid")
  change             Float         @default(0)
  status             String        @default("paid")
  paymentMethod      String        @default("CASH") @map("payment_method") // CASH, CARD, SPLIT, CREDIT
  cashAmount         Float         @default(0) @map("cash_amount")
  cardAmount         Float         @default(0) @map("card_amount")
  creditAmount       Float         @default(0) @map("credit_amount")
  totalCogs          Float         @default(0) @map("total_cogs")
  totalVat           Float         @default(0) @map("total_vat")
  grossProfit        Float         @default(0) @map("gross_profit")
  prescriptionId     String?       @map("prescription_id")
  prescriptionNumber String?       @map("prescription_number")
  cashierId          String?       @map("cashier_id")
  cashierName        String?       @map("cashier_name")
  notes              String        @default("")
  createdAt          DateTime      @default(now()) @map("created_at")
  pharmacy           Pharmacy      @relation(fields: [pharmacyId], references: [id])
  branch             Branch        @relation(fields: [branchId], references: [id])
  customer           Customer?     @relation(fields: [customerId], references: [id])
  prescription       Prescription? @relation(fields: [prescriptionId], references: [id])
  items              SaleItem[]
  returns            ReturnEntry[]
  arrears            Arrear[]

  @@index([pharmacyId])
  @@index([branchId])
  @@index([prescriptionId])
  @@map("sales")
}

model SaleItem {
  id          String    @id @default(uuid())
  saleId      String    @map("sale_id")
  productId   String    @map("product_id")
  productName String    @map("product_name")
  barcode     String
  quantity    Int       @default(1)
  unitPrice   Float     @default(0) @map("unit_price")
  subtotal    Float     @default(0)
  unitCost    Float     @default(0) @map("unit_cost")
  cogs        Float     @default(0)
  vatRate     Float     @default(0) @map("vat_rate")
  vatAmount   Float     @default(0) @map("vat_amount")
  batchId     String?   @map("batch_id")
  batchNumber String?   @map("batch_number")
  expiryDate  DateTime? @map("expiry_date")
  sale        Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id])
  batch       Batch?    @relation(fields: [batchId], references: [id])

  @@index([batchId])
  @@map("sale_items")
}

model Arrear {
  id         String          @id @default(uuid())
  pharmacyId String          @map("pharmacy_id")
  branchId   String          @map("branch_id")
  saleId     String?         @map("sale_id")
  customerId String          @map("customer_id")
  totalBill  Float           @default(0) @map("total_bill")
  amountPaid Float           @default(0) @map("amount_paid")
  balanceDue Float           @default(0) @map("balance_due")
  status     String          @default("pending")
  createdAt  DateTime        @default(now()) @map("created_at")
  pharmacy   Pharmacy        @relation(fields: [pharmacyId], references: [id])
  branch     Branch          @relation(fields: [branchId], references: [id])
  sale       Sale?           @relation(fields: [saleId], references: [id])
  customer   Customer        @relation(fields: [customerId], references: [id])
  payments   ArrearPayment[]

  @@index([pharmacyId])
  @@index([branchId])
  @@map("arrears")
}

model ArrearPayment {
  id            String   @id @default(uuid())
  arrearId      String   @map("arrear_id")
  amount        Float    @default(0)
  paymentSaleId String?  @map("payment_sale_id")
  createdAt     DateTime @default(now()) @map("created_at")
  arrear        Arrear   @relation(fields: [arrearId], references: [id], onDelete: Cascade)

  @@map("arrear_payments")
}

model StockPurchase {
  id             String       @id @default(uuid())
  pharmacyId     String       @map("pharmacy_id")
  branchId       String       @map("branch_id")
  productId      String       @map("product_id")
  distributorId  String?      @map("distributor_id")
  companyId      String?      @map("company_id")
  invoiceNumber  String       @default("") @map("invoice_number")
  quantity       Int          @default(0)
  purchasePrice  Float        @default(0) @map("purchase_price")
  salePrice      Float        @default(0) @map("sale_price")
  expiry         String?
  totalValue     Float        @default(0) @map("total_value")
  active         Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at")
  pharmacy       Pharmacy     @relation(fields: [pharmacyId], references: [id])
  branch         Branch       @relation(fields: [branchId], references: [id])
  product        Product      @relation(fields: [productId], references: [id])
  distributor    Distributor? @relation(fields: [distributorId], references: [id])
  company        Company?     @relation(fields: [companyId], references: [id])

  @@index([pharmacyId])
  @@index([branchId])
  @@map("stock_purchases")
}

model ReturnEntry {
  id           String       @id @default(uuid())
  pharmacyId   String       @map("pharmacy_id")
  branchId     String       @map("branch_id")
  saleId       String       @map("sale_id")
  refundAmount Float        @default(0) @map("refund_amount")
  reason       String       @default("")
  createdAt    DateTime     @default(now()) @map("created_at")
  pharmacy     Pharmacy     @relation(fields: [pharmacyId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  sale         Sale         @relation(fields: [saleId], references: [id])
  items        ReturnItem[]

  @@index([pharmacyId])
  @@index([branchId])
  @@map("returns")
}

model ReturnItem {
  id           String       @id @default(uuid())
  returnId     String       @map("return_id")
  productId    String       @map("product_id")
  productName  String       @map("product_name")
  quantity     Int          @default(0)
  refundAmount Float        @default(0) @map("refund_amount")
  returnEntry  ReturnEntry  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])

  @@map("return_items")
}

model Category {
  id         String    @id @default(uuid())
  pharmacyId String    @map("pharmacy_id")
  name       String
  vatRate    Float     @default(0) @map("vat_rate")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  pharmacy   Pharmacy  @relation(fields: [pharmacyId], references: [id])

  @@unique([pharmacyId, name])
  @@index([pharmacyId])
  @@map("categories")
}

model Expense {
  id         String   @id @default(uuid())
  pharmacyId String   @map("pharmacy_id")
  branchId   String   @map("branch_id")
  title      String
  category   String
  amount     Float    @default(0)
  notes      String   @default("")
  date       String
  createdAt  DateTime @default(now()) @map("created_at")
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id])
  branch     Branch   @relation(fields: [branchId], references: [id])

  @@index([pharmacyId])
  @@index([branchId])
  @@map("expenses")
}
/// ---------- NEW MODELS ----------
model Batch {
  id                  String   @id @default(uuid())
  pharmacyId          String   @map("pharmacy_id")
  branchId            String   @map("branch_id")
  productId           String   @map("product_id")
  batchNumber         String   @map("batch_number")
  expiryDate          DateTime @map("expiry_date")
  quantityInBaseUnits Int      @default(0) @map("quantity_in_base_units")
  costPricePerUnit    Decimal  @default(0) @db.Decimal(12,4) @map("cost_price_per_unit")
  salePricePerUnit    Decimal  @default(0) @db.Decimal(12,4) @map("sale_price_per_unit")
  status              String   @default("ACTIVE") // ACTIVE, QUARANTINED, RECALLED, DEPLETED
  isRecalled          Boolean  @default(false) @map("is_recalled")
  recallReason        String?  @map("recall_reason")
  gtin                String?  // optional GS1 GTIN
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  product             Product  @relation(fields: [productId], references: [id])
  branch              Branch   @relation(fields: [branchId], references: [id])
  movements           StockMovement[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  dispenseRecords      DispenseRecord[]
  controlledRegisters  ControlledDrugRegister[]
  saleItems            SaleItem[]
  transferItems        StockTransferItem[]   @relation("TransferSourceBatch")

  @@unique([branchId, productId, batchNumber])
  @@index([branchId, productId, expiryDate])
  @@index([isRecalled, status])
  @@map("batches")
}

model StockMovement {
  id              String   @id @default(uuid())
  pharmacyId      String   @map("pharmacy_id")
  branchId        String   @map("branch_id")
  productId       String   @map("product_id")
  batchId         String?  @map("batch_id")
  movementType    String   @map("movement_type") // PURCHASE_RECEIPT, SALE, RETURN, ADJUSTMENT, EXPIRED_DISCARD
  quantityDelta   Int      @map("quantity_delta") // + or -
  balanceAfter    Int      @map("balance_after")
  unitCost        Decimal  @default(0) @db.Decimal(12,4) @map("unit_cost")
  referenceNumber String?  @map("reference_number")
  reasonCode      String?  @map("reason_code")
  createdById     String?  @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  batch           Batch?   @relation(fields: [batchId], references: [id])
  product         Product  @relation(fields: [productId], references: [id])
  branch          Branch   @relation(fields: [branchId], references: [id])

  @@index([branchId, productId, createdAt])
  @@map("stock_movements")
}

model PurchaseInvoice {
  id              String                  @id @default(uuid())
  pharmacyId      String                  @map("pharmacy_id")
  branchId        String                  @map("branch_id")
  distributorId   String                  @map("distributor_id")
  invoiceNumber   String                  @map("invoice_number")
  invoiceDate     DateTime                @default(now()) @map("invoice_date")
  dueDate         DateTime?               @map("due_date")
  subtotal        Decimal                 @default(0) @db.Decimal(12, 4)
  discount        Decimal                 @default(0) @db.Decimal(12, 4)
  tax             Decimal                 @default(0) @db.Decimal(12, 4)
  totalAmount     Decimal                 @default(0) @db.Decimal(12, 4) @map("total_amount")
  paidAmount      Decimal                 @default(0) @db.Decimal(12, 4) @map("paid_amount")
  balanceDue      Decimal                 @default(0) @db.Decimal(12, 4) @map("balance_due")
  status          String                  @default("UNPAID") // UNPAID, PARTIAL, PAID, VOID
  paymentMethod   String?                 @map("payment_method") // CASH, BANK_TRANSFER, CHEQUE, CREDIT
  notes           String                  @default("")
  receivedBy      String?                 @map("received_by")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  pharmacy        Pharmacy                @relation(fields: [pharmacyId], references: [id])
  branch          Branch                  @relation(fields: [branchId], references: [id])
  distributor     Distributor             @relation(fields: [distributorId], references: [id])
  items           PurchaseInvoiceItem[]
  payments        DistributorPayment[]

  @@unique([pharmacyId, distributorId, invoiceNumber])
  @@index([pharmacyId])
  @@index([branchId])
  @@index([distributorId])
  @@index([status])
  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id                 String          @id @default(uuid())
  invoiceId          String          @map("invoice_id")
  productId          String          @map("product_id")
  batchId            String?         @map("batch_id")
  batchNumber        String          @map("batch_number")
  expiryDate         DateTime        @map("expiry_date")
  quantityPacks      Int             @default(1) @map("quantity_packs")
  unitsPerPack       Int             @default(1) @map("units_per_pack")
  quantityBaseUnits  Int             @default(1) @map("quantity_base_units")
  unitCost           Decimal         @default(0) @db.Decimal(12, 4) @map("unit_cost")
  salePrice          Decimal         @default(0) @db.Decimal(12, 4) @map("sale_price")
  totalCost          Decimal         @default(0) @db.Decimal(12, 4) @map("total_cost")
  createdAt          DateTime        @default(now()) @map("created_at")
  invoice            PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product            Product         @relation(fields: [productId], references: [id])
  batch              Batch?          @relation(fields: [batchId], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@index([batchNumber])
  @@map("purchase_invoice_items")
}

model DistributorPayment {
  id              String           @id @default(uuid())
  pharmacyId      String           @map("pharmacy_id")
  branchId        String           @map("branch_id")
  distributorId   String           @map("distributor_id")
  invoiceId       String?          @map("invoice_id")
  amount          Decimal          @db.Decimal(12, 4)
  paymentMethod   String           @default("CASH") @map("payment_method") // CASH, BANK_TRANSFER, CHEQUE
  referenceNumber String           @default("") @map("reference_number")
  paidAt          DateTime         @default(now()) @map("paid_at")
  notes           String           @default("")
  createdAt       DateTime         @default(now()) @map("created_at")
  pharmacy        Pharmacy         @relation(fields: [pharmacyId], references: [id])
  branch          Branch           @relation(fields: [branchId], references: [id])
  distributor     Distributor      @relation(fields: [distributorId], references: [id])
  invoice         PurchaseInvoice? @relation(fields: [invoiceId], references: [id])

  @@index([pharmacyId])
  @@index([branchId])
  @@index([distributorId])
  @@index([invoiceId])
  @@map("distributor_payments")
}

model Prescription {
  id                  String             @id @default(uuid())
  pharmacyId          String             @map("pharmacy_id")
  branchId            String             @map("branch_id")
  prescriptionNumber  String             @map("prescription_number")
  patientName         String             @map("patient_name")
  patientIdentifier   String             @default("") @map("patient_identifier") // National ID / Iqama / Passport / Phone
  patientPhone        String             @default("") @map("patient_phone")
  patientAge          Int?               @map("patient_age")
  patientGender       String?            @map("patient_gender") // MALE, FEMALE, OTHER
  doctorName          String             @map("doctor_name")
  doctorLicense       String             @default("") @map("doctor_license")
  clinicOrHospital    String             @default("") @map("clinic_or_hospital")
  diagnosis           String             @default("")
  prescribedDate      DateTime           @default(now()) @map("prescribed_date")
  status              String             @default("PENDING") // PENDING, VERIFIED, PARTIALLY_DISPENSED, FULLY_DISPENSED, CANCELLED
  verifiedById        String?            @map("verified_by_id")
  verifiedByName      String?            @map("verified_by_name")
  verifiedAt          DateTime?          @map("verified_at")
  notes               String             @default("")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  pharmacy            Pharmacy           @relation(fields: [pharmacyId], references: [id])
  branch              Branch             @relation(fields: [branchId], references: [id])
  items               PrescriptionItem[]
  dispenseRecords     DispenseRecord[]
  controlledRegisters ControlledDrugRegister[]
  sales               Sale[]

  @@unique([pharmacyId, prescriptionNumber])
  @@index([pharmacyId])
  @@index([branchId])
  @@index([status])
  @@index([patientIdentifier])
  @@map("prescriptions")
}

model PrescriptionItem {
  id                 String           @id @default(uuid())
  prescriptionId     String           @map("prescription_id")
  prescribedDrugName String           @map("prescribed_drug_name")
  productId          String?          @map("product_id")
  dosage             String           @default("")
  frequency          String           @default("")
  duration           String           @default("")
  instructions       String           @default("")
  quantityPrescribed Int              @map("quantity_prescribed")
  quantityDispensed  Int              @default(0) @map("quantity_dispensed")
  quantityRemaining  Int              @default(0) @map("quantity_remaining")
  status             String           @default("PENDING") // PENDING, PARTIAL, COMPLETED
  isControlled       Boolean          @default(false) @map("is_controlled")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  prescription       Prescription     @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  product            Product?         @relation(fields: [productId], references: [id])
  dispenseRecords    DispenseRecord[]

  @@index([prescriptionId])
  @@index([productId])
  @@map("prescription_items")
}

model DispenseRecord {
  id                 String           @id @default(uuid())
  prescriptionId     String           @map("prescription_id")
  prescriptionItemId String           @map("prescription_item_id")
  dispensedProductId String           @map("dispensed_product_id")
  batchId            String?          @map("batch_id")
  quantity           Int              @map("quantity")
  isPartialFill      Boolean          @default(false) @map("is_partial_fill")
  isSubstitution     Boolean          @default(false) @map("is_substitution")
  originalProductId  String?          @map("original_product_id")
  substitutionReason String?          @map("substitution_reason")
  pharmacistId       String?          @map("pharmacist_id")
  pharmacistName     String?          @map("pharmacist_name")
  dispensedAt        DateTime         @default(now()) @map("dispensed_at")
  notes              String           @default("")
  prescription       Prescription     @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  prescriptionItem   PrescriptionItem @relation(fields: [prescriptionItemId], references: [id], onDelete: Cascade)
  dispensedProduct   Product          @relation("DispensedProduct", fields: [dispensedProductId], references: [id])
  batch              Batch?           @relation(fields: [batchId], references: [id])
  controlledRegisters ControlledDrugRegister[]

  @@index([prescriptionId])
  @@index([prescriptionItemId])
  @@index([dispensedProductId])
  @@index([dispensedAt])
  @@map("dispense_records")
}

model ControlledDrugRegister {
  id                 String           @id @default(uuid())
  pharmacyId         String           @map("pharmacy_id")
  branchId           String           @map("branch_id")
  productId          String           @map("product_id")
  batchId            String?          @map("batch_id")
  prescriptionId     String?          @map("prescription_id")
  dispenseRecordId   String?          @map("dispense_record_id")
  patientName        String           @map("patient_name")
  patientIdentifier  String           @map("patient_identifier")
  doctorName         String           @map("doctor_name")
  doctorLicense      String           @map("doctor_license")
  transactionType    String           @map("transaction_type") // DISPENSE, RECEIPT, ADJUSTMENT, DISCARD
  quantity           Int              @map("quantity")
  balanceAfter       Int              @map("balance_after")
  pharmacistId       String?          @map("pharmacist_id")
  pharmacistName     String           @map("pharmacist_name")
  witnessName        String?          @map("witness_name")
  notes              String           @default("")
  recordedAt         DateTime         @default(now()) @map("recorded_at")
  pharmacy           Pharmacy         @relation(fields: [pharmacyId], references: [id])
  branch             Branch           @relation(fields: [branchId], references: [id])
  product            Product          @relation(fields: [productId], references: [id])
  batch              Batch?           @relation(fields: [batchId], references: [id])
  prescription       Prescription?    @relation(fields: [prescriptionId], references: [id])
  dispenseRecord     DispenseRecord?  @relation(fields: [dispenseRecordId], references: [id])

  @@index([pharmacyId])
  @@index([branchId])
  @@index([productId])
  @@index([recordedAt])
  @@map("controlled_drug_registers")
}

model BranchPriceOverride {
  id            String   @id @default(uuid())
  pharmacyId    String   @map("pharmacy_id")
  branchId      String   @map("branch_id")
  productId     String   @map("product_id")
  salePrice     Float    @map("sale_price")
  reason        String   @default("")
  effectiveDate DateTime @default(now()) @map("effective_date")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  pharmacy      Pharmacy @relation(fields: [pharmacyId], references: [id])
  branch        Branch   @relation(fields: [branchId], references: [id])
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([pharmacyId])
  @@map("branch_price_overrides")
}

model StockTransfer {
  id                   String              @id @default(uuid())
  transferNumber       String              @unique @map("transfer_number")
  pharmacyId           String              @map("pharmacy_id")
  sourceBranchId       String              @map("source_branch_id")
  destinationBranchId  String              @map("destination_branch_id")
  status               String              @default("PENDING") // PENDING, APPROVED, IN_TRANSIT, RECEIVED, REJECTED, CANCELLED
  requestedById        String?             @map("requested_by_id")
  requestedByName      String?             @map("requested_by_name")
  approvedById         String?             @map("approved_by_id")
  approvedByName       String?             @map("approved_by_name")
  approvedAt           DateTime?           @map("approved_at")
  receivedById         String?             @map("received_by_id")
  receivedByName       String?             @map("received_by_name")
  receivedAt           DateTime?           @map("received_at")
  rejectionReason      String?             @map("rejection_reason")
  notes                String              @default("")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  pharmacy             Pharmacy            @relation(fields: [pharmacyId], references: [id])
  sourceBranch         Branch              @relation("TransfersSent", fields: [sourceBranchId], references: [id])
  destinationBranch    Branch              @relation("TransfersReceived", fields: [destinationBranchId], references: [id])
  items                StockTransferItem[]

  @@index([pharmacyId])
  @@index([sourceBranchId])
  @@index([destinationBranchId])
  @@index([status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id                   String        @id @default(uuid())
  transferId           String        @map("transfer_id")
  productId            String        @map("product_id")
  productName          String        @map("product_name")
  barcode              String
  sourceBatchId        String?       @map("source_batch_id")
  batchNumber          String        @map("batch_number")
  expiryDate           DateTime      @map("expiry_date")
  quantity             Int           @default(1)
  unitCost             Float         @default(0) @map("unit_cost")
  salePrice            Float         @default(0) @map("sale_price")
  destinationBatchId   String?       @map("destination_batch_id")
  createdAt            DateTime      @default(now()) @map("created_at")

  transfer             StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product              Product       @relation(fields: [productId], references: [id])
  sourceBatch          Batch?        @relation("TransferSourceBatch", fields: [sourceBatchId], references: [id])

  @@index([transferId])
  @@index([productId])
  @@map("stock_transfer_items")
}




